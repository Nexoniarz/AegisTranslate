{
  "manifest_version": 2,
  "name": "AegisTranslate",
  "version": "0.2.0",
  "description": "Private, on-device translation of web text and the text in images. Runs in Firefox with WebGPU, or on your best GPU through an optional local helper.",
  "author": "Nexoniarz",
  "homepage_url": "https://github.com/Nexoniarz/AegisTranslate",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aegistranslate@nexoniarz",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "menus",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "AegisTranslate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate the selected text"
    }
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
